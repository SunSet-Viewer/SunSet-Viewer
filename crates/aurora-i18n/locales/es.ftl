hud-local-scale-help = Mantén pulsada la tecla de HUD: arrastra con el botón izquierdo para mover, rueda para cambiar el tamaño, Shift para pasos más precisos. El tamaño se guarda en este PC por nombre y creador, para esta cuenta. Al editar un HUD, la rueda sin esta tecla amplía la vista de todos los HUD.
cli-help = { "SunSet Viewer\u000A\u000AUso: aurora-viewer [--title <texto>] [--fps-limit <fps>] [--vr] [--language <código>] [--grid <nombre>]\u000A                     [--login <nombre> <apellido> <contraseña>] [--version] [--uninstall] [<slurl>]\u000A\u000A  --title <texto>   Asigna un nombre a esta ventana (\"SunSet Viewer <versión> - <texto>\") y a su archivo\u000A                   de registro (aurora-<texto>.log, aurora-demo-<texto>.log en modo demo)\u000A  --fps-limit <fps>  Limita este proceso a 1..500 FPS sin guardar preferencias\u000A  --language <código>  Anula el idioma de la IU de este proceso (" }{ $languages }{ ")\u000A  --grid <nombre>    Inicia en agni, aditi, un nombre de grid guardado o una URI de inicio de sesión (también --loginuri <uri>)\u000A  --login <nombre> <apellido> <contraseña>  Inicia sesión con esta cuenta de inmediato\u000A  <slurl>, --url <slurl>  Inicia en este lugar; no se lee nada después. Un visor en ejecución\u000A                   ya lo recibe en su lugar\u000A  --vr             Entra en VR una vez que se muestre el mundo (con visor conectado)\u000A  -V, --version   Muestra la versión compilada del visor sin iniciarlo\u000A  --uninstall      Elimina lo que SunSet registró fuera de sus carpetas (manejador de enlaces,\u000A                   almacén de credenciales, complemento de Blender), muéstralo junto con las carpetas restantes, y luego sal\u000A  -h, --help       Muestra esta ayuda\u000A\u000ALos modificadores de prueba son variables de entorno (AURORA_DEMO=1, AURORA_CAPTURE=...):\u000Aconsulta README.md." }
demo-media-page = { "data:text/html;charset=utf-8,<html><body style='margin:0;height:100vh;background:linear-gradient(135deg,%232a1f4a,%230f6d6d);color:white;font:56px sans-serif;text-align:center'><h1 style='margin:40px 0 10px'>Aurora media</h1><p id='t' style='font-size:90px;margin:10px'>--</p><button onclick=\"document.body.style.background='%237a3b9c';this.textContent='¡Clic!'\" style='font-size:48px;padding:10px 40px'>Clic</button><br><input placeholder='Escribe aquí' style='font-size:44px;margin-top:30px;width:70%'><script>setInterval(function(){document.getElementById('t').textContent=new Date().toLocaleTimeString()},250)</script></body></html>" }

