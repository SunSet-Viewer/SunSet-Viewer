    { "    {" }
            // Cores e recuo LSL
            integer count = 2;
            vector tint = <1.0, 0.5, 0.0>;
            llSay(PUBLIC_CHANNEL, "Hello 🐺");
    { "    }" }
    { "}" }
    ```
